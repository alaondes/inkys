rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Core helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function getAdminUserDoc(email) {
      return get(/databases/$(database)/documents/admin_users/$(email));
    }

    function existsAdminUserDoc(email) {
      return exists(/databases/$(database)/documents/admin_users/$(email));
    }

    function hasPermission(permission) {
      return isSignedIn() && 
        request.auth.token.email != null &&
        existsAdminUserDoc(request.auth.token.email.lower()) &&
        getAdminUserDoc(request.auth.token.email.lower()).data.permissions[permission] == true;
    }

    // Collection: admin_users
    match /admin_users/{email} {
      allow read: if isSignedIn() && (
        request.auth.token.email.lower() == email.lower() ||
        hasPermission('users')
      );
      allow write: if isSignedIn() && (
        // Allow user to auto-provision their own user document on first login (if it does not exist)
        (request.auth.token.email.lower() == email.lower() && !existsAdminUserDoc(email.lower())) ||
        // Admin or users manager can write any user document
        hasPermission('users')
      );
    }

    // Collection: orders
    match /orders/{orderId} {
      allow read: if hasPermission('orders');
      allow write: if hasPermission('orders');
      allow create: if true; // Any client checkout
    }
    
    // Collection: avulso_products
    match /avulso_products/{productId} {
      allow read: if true;
      allow write: if hasPermission('avulsos');
    }
    
    // Collection: products
    match /products/{productId} {
      allow read: if true;
      allow create, delete: if hasPermission('products');
      allow update: if hasPermission('products') || (
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['stock'])
      );
    }
    
    // Collection: coupons
    match /coupons/{couponId} {
      allow read: if true;
      allow write: if hasPermission('coupons');
    }
    
    // Collection: config
    match /config/{settingId} {
      allow read: if true;
      allow write: if hasPermission('settings');
    }
    
    // Collection: documents
    match /documents/{documentId} {
      allow read: if true;
      allow write: if hasPermission('documents');
    }

    // Collection: customers
    match /customers/{customerId} {
      allow read: if hasPermission('customers');
      allow write: if hasPermission('customers') || true;
    }

    // Collection: counters
    match /counters/{counterId} {
      allow read, write: if true;
    }
  }
}
