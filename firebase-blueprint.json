{
  "entities": {
    "Order": {
      "title": "Order",
      "description": "Customer order created at checkout.",
      "type": "object",
      "properties": {
        "customer": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "total": { "type": "number" },
        "status": { "type": "string" },
        "date": { "type": "object" },
        "items": { "type": "array" },
        "shippingInfo": { "type": "object" },
        "trackingCode": { "type": "string" },
        "coupon": { "type": "string" }
      }
    },
    "Product": {
      "title": "Product",
      "description": "Product in the store.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "image": { "type": "string" },
        "colors": { "type": "array" },
        "badge": { "type": "string" },
        "hidden": { "type": "boolean" },
        "category": { "type": "string" },
        "stock": { "type": "number" }
      }
    },
    "Coupon": {
      "title": "Coupon",
      "description": "Discount coupon for the store.",
      "type": "object",
      "properties": {
        "code": { "type": "string" },
        "type": { "type": "string" },
        "value": { "type": "number" },
        "active": { "type": "boolean" },
        "minPurchase": { "type": "number" }
      }
    },
    "Settings": {
      "title": "Settings",
      "description": "Store settings like colors and banners.",
      "type": "object",
      "properties": {
        "primaryColor": { "type": "string" },
        "adminPrimaryColor": { "type": "string" },
        "bannerTop": { "type": "string" },
        "bannerMiddle": { "type": "string" },
        "whatsappNumber": { "type": "string" },
        "logoUrl": { "type": "string" },
        "paymentMethods": { "type": "object" },
        "categories": { "type": "array" },
        "freeShippingThreshold": { "type": "number" },
        "fixedShippingRates": { "type": "object" }
      }
    },
    "Document": {
      "title": "Document",
      "description": "Custom invoice, quote or receipt document history.",
      "type": "object",
      "properties": {
        "type": { "type": "string" },
        "date": { "type": "string" },
        "customerName": { "type": "string" },
        "customerDoc": { "type": "string" },
        "items": { "type": "array" },
        "discount": { "type": "number" },
        "subtotal": { "type": "number" },
        "total": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "paymentConditions": { "type": "string" },
        "notes": { "type": "string" },
        "validUntil": { "type": "string" },
        "status": { "type": "string" },
        "emitter": { "type": "object" },
        "design": { "type": "object" },
        "createdAt": { "type": "string" }
      }
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Admin users and sellers permissions.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "role": { "type": "string" },
        "permissions": { "type": "object" },
        "createdAt": { "type": "object" }
      }
    },
    "HREmployee": {
      "title": "HREmployee",
      "description": "Company employee record for HR module.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "cpf": { "type": "string" },
        "rg": { "type": "string" },
        "birthDate": { "type": "string" },
        "phone": { "type": "string" },
        "email": { "type": "string" },
        "address": { "type": "string" },
        "emergencyContact": { "type": "string" },
        "roleTitle": { "type": "string" },
        "department": { "type": "string" },
        "contractType": { "type": "string" },
        "admissionDate": { "type": "string" },
        "workSchedule": { "type": "string" },
        "status": { "type": "string" },
        "baseSalary": { "type": "number" },
        "commissionPct": { "type": "number" },
        "salesGoalMonthly": { "type": "number" },
        "pixKey": { "type": "string" },
        "bankName": { "type": "string" },
        "bankAgency": { "type": "string" },
        "bankAccount": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "HRPayroll": {
      "title": "HRPayroll",
      "description": "Payroll record for an employee.",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "refMonth": { "type": "string" },
        "baseSalary": { "type": "number" },
        "commissionAmount": { "type": "number" },
        "bonusAmount": { "type": "number" },
        "overtimeAmount": { "type": "number" },
        "advancesAmount": { "type": "number" },
        "deductionsAmount": { "type": "number" },
        "netSalary": { "type": "number" },
        "status": { "type": "string" },
        "paymentDate": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      }
    },
    "HRTimeRecord": {
      "title": "HRTimeRecord",
      "description": "Time tracking record for employee.",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "date": { "type": "string" },
        "clockIn": { "type": "string" },
        "clockOut": { "type": "string" },
        "lunchStart": { "type": "string" },
        "lunchEnd": { "type": "string" },
        "totalHours": { "type": "number" },
        "status": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "HRVacation": {
      "title": "HRVacation",
      "description": "Vacation schedule for employee.",
      "type": "object",
      "properties": {
        "employeeId": { "type": "string" },
        "employeeName": { "type": "string" },
        "startDate": { "type": "string" },
        "endDate": { "type": "string" },
        "daysCount": { "type": "number" },
        "status": { "type": "string" },
        "notes": { "type": "string" }
      }
    },
    "Counter": {
      "title": "Counter",
      "description": "Sequential order and quote ID counters.",
      "type": "object",
      "properties": {
        "nextOrderNumber": { "type": "number" },
        "nextBudgetNumber": { "type": "number" }
      }
    }
  },
  "firestore": {
    "/counters/{counterId}": {
      "schema": "Counter",
      "description": "Database sequence counters for documents, orders, etc."
    },
    "/admin_users/{email}": {
      "schema": "AdminUser",
      "description": "Collection of all admin users and sellers with specific permissions."
    },
    "/documents/{documentId}": {
      "schema": "Document",
      "description": "History of all custom issued documents (quotes, receipts)."
    },
    "/orders/{orderId}": {
      "schema": "Order",
      "description": "Collection of all orders."
    },
    "/products/{productId}": {
      "schema": "Product",
      "description": "Collection of all products."
    },
    "/coupons/{couponId}": {
      "schema": "Coupon",
      "description": "Collection of all coupons."
    },
    "/config/{settingId}": {
      "schema": "Settings",
      "description": "Singleton configuration for the store."
    },
    "/hr_employees/{employeeId}": {
      "schema": "HREmployee",
      "description": "Employees list for HR management."
    },
    "/hr_payrolls/{payrollId}": {
      "schema": "HRPayroll",
      "description": "Payroll records per employee and month."
    },
    "/hr_time_records/{recordId}": {
      "schema": "HRTimeRecord",
      "description": "Time clock records per employee."
    },
    "/hr_vacations/{vacationId}": {
      "schema": "HRVacation",
      "description": "Vacation schedules per employee."
    }
  }
}
